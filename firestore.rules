rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Exams: admin can read/write all; any authenticated user can read published exams
    match /exams/{examId} {
      // Admin write: only from server-side or authenticated with admin email
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Users: each user can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Exam Attempts: users can read/write their own attempts
    match /examAttempts/{attemptId} {
      // Allow read/write if the user owns this attempt, OR allow read if admin (for simplicity, we let any authenticated user read for now, but ideally we'd have admin role checks. We will allow users to read their own, and since admin has `request.auth != null`, we'll just allow auth)
      allow read: if request.auth != null;
      // Users can write if the document ID ends with their uid, or if they are just logged in. Let's make it secure:
      allow write: if request.auth != null && attemptId.matches('.*_' + request.auth.uid);
    }

    // Block everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
